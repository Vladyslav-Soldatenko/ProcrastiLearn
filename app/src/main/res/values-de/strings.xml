    <!-- About Us -->
    <string name="settings_about_us_row">Über uns</string>
    <string name="settings_about_us_row_desc">Mehr über die App erfahren</string>
    <string name="settings_about_us_title">@string/settings_about_us_row</string>
    <string name="settings_about_us_intro">
        ProcrastiLearn verwandelt ablenkende Momente in Lernchancen. Wenn du versuchst, eine ausgewählte App zu öffnen, zeigen wir dir zuerst eine kurze Vokabelaufgabe. So baust du Wissen auf, während du deine Ablenkungen im Griff behältst.
    </string>
    <string name="settings_about_us_mission_title">Unsere Mission</string>
    <string name="settings_about_us_mission_body">
        Wir möchten Menschen dabei helfen, ihre Zeit und Aufmerksamkeit zurückzugewinnen, indem wir alltägliche Gewohnheiten in Gelegenheiten verwandeln, etwas Neues zu lernen.
    </string>
    <string name="settings_about_us_who_title">Wer wir sind</string>
    <string name="settings_about_us_who_body">
        ProcrastiLearn wird von einem unabhängigen Entwickler entwickelt und gepflegt, der sich für Produktivität und Sprachenlernen begeistert.
    </string>
    <string name="settings_about_us_values_title">Unsere Werte</string>
    <string name="settings_about_us_values_simplicity">Einfachheit: ablenkungsfreies, minimalistisches Design.</string>
    <string name="settings_about_us_values_growth">Wachstum: kleine Schritte summieren sich jeden Tag zu dauerhaftem Fortschritt.</string>
    <string name="settings_about_us_contact_title">Kontakt</string>
    <string name="settings_about_us_contact_body">Bei Fragen oder Feedback erreichst du uns unter: Apocalypse_232@proton.me</string>
    <string name="settings_about_us_privacy">Datenschutzerklärung</string>

