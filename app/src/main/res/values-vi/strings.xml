    <string name="settings_about_us_title">@string/settings_about_us_row</string>
    <string name="settings_about_us_intro">
        ProcrastiLearn biến những khoảnh khắc mất tập trung thành cơ hội học tập. Khi bạn cố mở một ứng dụng đã chọn, chúng tôi sẽ cho bạn thử sức với một câu hỏi từ vựng nhanh trước. Nhờ vậy, bạn vừa trau dồi kiến thức vừa kiểm soát được sự xao nhãng.
    </string>
    <string name="settings_about_us_mission_title">Sứ mệnh của chúng tôi</string>
    <string name="settings_about_us_mission_body">
        Chúng tôi muốn giúp mọi người giành lại thời gian và sự tập trung bằng cách biến những thói quen hằng ngày thành cơ hội học điều gì đó mới.
    </string>
    <string name="settings_about_us_who_title">Chúng tôi là ai</string>
    <string name="settings_about_us_who_body">
        ProcrastiLearn được xây dựng và duy trì bởi một nhà phát triển độc lập đam mê năng suất làm việc và học ngoại ngữ.
    </string>
    <string name="settings_about_us_values_title">Giá trị cốt lõi</string>
