    <!-- ─── Accessibility disclosure (A11y) ─────────────────────────────────── -->
    <string name="a11y_disclosure_title">Vì sao chúng tôi cần quyền Trợ năng</string>
    <string name="a11y_disclosure_description">
        Ứng dụng này sử dụng quyền Dịch vụ trợ năng của Android để phát hiện khi bạn mở các ứng dụng đã chọn
        (ví dụ: TikTok, Reddit hoặc bất kỳ ứng dụng nào khác bạn chọn) để hiển thị một bài học ngắn trước khi bạn tiếp tục.
    </string>

    <string name="a11y_disclosure_section_access">Những gì chúng tôi truy cập</string>

    <string name="a11y_disclosure_access_details">
        • Ứng dụng nào đang hiển thị trên màn hình của bạn.\n
        • Chúng tôi KHÔNG đọc mật khẩu, tin nhắn hay bất kỳ văn bản nào trên màn hình.\n
        • Dữ liệu của bạn không bao giờ rời khỏi thiết bị và không bao giờ bị bán hay chia sẻ.
    </string>

    <string name="a11y_disclosure_section_usage">Dữ liệu được dùng như thế nào</string>

    <!-- Original paragraph -->
    <string name="a11y_disclosure_usage_details">
        Chỉ để kích hoạt lớp phủ học tập cho các ứng dụng bạn đã chọn.
        Bạn có thể tắt tính năng này bất cứ lúc nào trong Cài đặt. Chúng tôi không bán hay chia sẻ dữ liệu này,
        nó không bao giờ rời khỏi thiết bị của bạn.
    </string>

    <string name="a11y_disclosure_checkbox">
        Tôi hiểu và đồng ý cho phép ứng dụng này sử dụng quyền Dịch vụ trợ năng cho mục đích này.
    </string>
    <string name="a11y_disclosure_accept">Đồng ý &amp; Tiếp tục</string>
    <string name="a11y_disclosure_decline">@string/action_not_now</string>
    <string name="a11y_disclosure_privacy">Chính sách bảo mật &amp; chi tiết</string>

