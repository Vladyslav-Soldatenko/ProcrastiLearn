    <!-- About Us -->
    <string name="settings_about_us_row">Tentang kami</string>
    <string name="settings_about_us_row_desc">Pelajari lebih lanjut tentang aplikasi ini</string>
    <string name="settings_about_us_title">@string/settings_about_us_row</string>
    <string name="settings_about_us_intro">
        ProcrastiLearn mengubah momen-momen menunda jadi kesempatan belajar. Saat kamu mencoba membuka aplikasi yang dipilih, kami menampilkan tantangan kosakata singkat terlebih dahulu. Dengan begitu, kamu menambah pengetahuan sambil tetap mengendalikan gangguan.
    </string>
    <string name="settings_about_us_mission_title">Misi Kami</string>
    <string name="settings_about_us_mission_body">
        Kami ingin membantu orang mendapatkan kembali waktu dan perhatiannya dengan mengubah kebiasaan sehari-hari menjadi kesempatan untuk belajar hal baru.
    </string>
    <string name="settings_about_us_who_title">Siapa Kami</string>
    <string name="settings_about_us_who_body">
        ProcrastiLearn dibuat dan dikelola oleh developer independen yang menyukai produktivitas dan pembelajaran bahasa.
    </string>
    <string name="settings_about_us_values_title">Nilai-Nilai Kami</string>
