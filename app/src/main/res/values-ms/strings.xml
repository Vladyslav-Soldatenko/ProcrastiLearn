    <string name="settings_about_us_row">Tentang kami</string>
    <string name="settings_about_us_row_desc">Ketahui lebih lanjut tentang apl ini</string>
    <string name="settings_about_us_title">@string/settings_about_us_row</string>
    <string name="settings_about_us_intro">ProcrastiLearn mengubah saat-saat yang mengganggu tumpuan menjadi peluang untuk belajar. Apabila anda cuba membuka apl terpilih, kami memaparkan cabaran kosa kata ringkas terlebih dahulu. Dengan cara ini, anda membina pengetahuan sambil mengawal gangguan.</string>
    <string name="settings_about_us_mission_title">Misi Kami</string>
    <string name="settings_about_us_mission_body">Kami mahu membantu orang ramai mendapatkan semula masa dan perhatian mereka dengan mengubah tabiat seharian menjadi peluang untuk mempelajari sesuatu yang baharu.</string>
    <string name="settings_about_us_who_title">Siapa Kami</string>
    <string name="settings_about_us_who_body">ProcrastiLearn dibangunkan dan diselenggara oleh pembangun bebas yang meminati produktiviti dan pembelajaran bahasa.</string>
    <string name="settings_about_us_values_title">Nilai Kami</string>
    <string name="settings_about_us_values_simplicity">Kesederhanaan: reka bentuk minimal tanpa gangguan.</string>
    <string name="settings_about_us_values_growth">Perkembangan: langkah kecil setiap hari membawa kemajuan yang berkekalan.</string>
    <string name="settings_about_us_contact_title">Hubungi</string>
    <string name="settings_about_us_contact_body">Jika anda ada soalan atau maklum balas, hubungi kami di: Apocalypse_232@proton.me</string>
