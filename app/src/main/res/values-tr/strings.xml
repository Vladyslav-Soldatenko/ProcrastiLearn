    <!-- About Us -->
    <string name="settings_about_us_row">Hakkımızda</string>
    <string name="settings_about_us_row_desc">Uygulama hakkında daha fazla bilgi al</string>
    <string name="settings_about_us_title">@string/settings_about_us_row</string>
    <string name="settings_about_us_intro">
        ProcrastiLearn, dikkat dağıtan anları öğrenme fırsatlarına dönüştürür. Seçtiğin bir uygulamayı açmaya çalıştığında, önce sana kısa bir kelime sorusu gösteririz. Böylece dikkatini dağıtan şeyleri kontrol altında tutarken bilgini de geliştirmiş olursun.
    </string>
    <string name="settings_about_us_mission_title">Misyonumuz</string>
    <string name="settings_about_us_mission_body">
        Günlük alışkanlıkları yeni bir şeyler öğrenme fırsatlarına dönüştürerek insanların zamanlarını ve dikkatlerini yeniden kazanmalarına yardımcı olmak istiyoruz.
    </string>
    <string name="settings_about_us_who_title">Biz Kimiz</string>
    <string name="settings_about_us_who_body">
        ProcrastiLearn, üretkenlik ve dil öğrenimine tutkuyla bağlı bağımsız bir geliştirici tarafından geliştirilmekte ve sürdürülmektedir.
    </string>
    <string name="settings_about_us_values_title">Değerlerimiz</string>
    <string name="settings_about_us_values_simplicity">Sadelik: dikkat dağıtmayan, minimal tasarım.</string>
    <string name="settings_about_us_values_growth">Gelişim: her gün atılan küçük adımlar kalıcı ilerlemeye dönüşür.</string>
