    <!-- ─── Accessibility disclosure (A11y) ─────────────────────────────────── -->
    <string name="a11y_disclosure_title">Dlaczego potrzebujemy dostępności</string>
    <string name="a11y_disclosure_description">
        Ta aplikacja korzysta z uprawnienia usługi ułatwień dostępu systemu Android, aby wykrywać moment otwarcia wybranych aplikacji
        (np. TikTok, Reddit lub dowolnej innej aplikacji, którą wybierzesz), tak aby móc pokazać krótkie zadanie do nauki, zanim przejdziesz dalej.
    </string>

    <string name="a11y_disclosure_section_access">Do czego mamy dostęp</string>

    <string name="a11y_disclosure_access_details">
        • Jaka aplikacja jest aktualnie na ekranie.\n
        • NIE odczytujemy Twoich haseł, wiadomości ani tekstu wyświetlanego na ekranie.\n
        • Twoje dane nigdy nie opuszczają urządzenia i nigdy nie są sprzedawane ani udostępniane.
    </string>

    <string name="a11y_disclosure_section_usage">Jak są wykorzystywane</string>

    <!-- Original paragraph -->
    <string name="a11y_disclosure_usage_details">
        Wyłącznie po to, by uruchamiać nakładkę do nauki dla wybranych przez Ciebie aplikacji.
        Możesz wyłączyć tę funkcję w dowolnym momencie w ustawieniach. Nie sprzedajemy ani nie udostępniamy tych danych,
        nigdy nie opuszczają one Twojego urządzenia.
    </string>

    <string name="a11y_disclosure_checkbox">
        Rozumiem i zgadzam się, aby ta aplikacja korzystała z uprawnienia usługi ułatwień dostępu w tym celu.
    </string>
    <string name="a11y_disclosure_accept">Akceptuj i kontynuuj</string>
    <string name="a11y_disclosure_decline">@string/action_not_now</string>
    <string name="a11y_disclosure_privacy">Polityka prywatności i szczegóły</string>

