    <string name="settings_about_us_title">@string/settings_about_us_row</string>
    <string name="settings_about_us_intro">Ginagawang pagkakataon sa pag-aaral ng ProcrastiLearn ang mga sandali ng pagkagambala. Kapag sinusubukan mong magbukas ng napiling app, magpapakita muna kami ng mabilis na hamon sa bokabularyo. Sa ganitong paraan, nadaragdagan ang iyong kaalaman habang napipigilan ang mga distraksiyon.</string>
    <string name="settings_about_us_mission_title">Ang Aming Misyon</string>
    <string name="settings_about_us_mission_body">Gusto naming tulungan ang mga tao na mabawi ang kanilang oras at atensyon sa pamamagitan ng pagliko ng araw-araw na gawi tungo sa mga pagkakataong matuto ng bago.</string>
    <string name="settings_about_us_who_title">Sino Kami</string>
    <string name="settings_about_us_who_body">Ang ProcrastiLearn ay binuo at pinapanatili ng isang independent developer na mahilig sa productivity at pag-aaral ng wika.</string>
    <string name="settings_about_us_values_title">Ang Aming Mga Halaga</string>
    <string name="settings_about_us_values_simplicity">Simple: minimal na disenyong walang distraksiyon.</string>
    <string name="settings_about_us_values_growth">Pag-unlad: ang maliliit na hakbang araw-araw ay humahantong sa pangmatagalang progreso.</string>
    <string name="settings_about_us_contact_title">Makipag-ugnayan</string>
    <string name="settings_about_us_contact_body">Kung may mga tanong o puna ka, makipag-ugnayan sa amin sa: Apocalypse_232@proton.me</string>
    <string name="settings_about_us_privacy">Patakaran sa Privacy</string>
