    <!-- About Us -->
    <string name="settings_about_us_row">हमारे बारे में</string>
    <string name="settings_about_us_row_desc">ऐप के बारे में और जानें</string>
    <string name="settings_about_us_title">@string/settings_about_us_row</string>
    <string name="settings_about_us_intro">
        ProcrastiLearn डिस्ट्रैक्शन के पलों को सीखने के मौके में बदल देता है। जब आप कोई चुना हुआ ऐप खोलने की कोशिश करते हैं, तो हम आपको पहले एक छोटा वोकैबुलरी चैलेंज दिखाते हैं। इस तरह आप डिस्ट्रैक्शन को काबू में रखते हुए भी कुछ नया सीखते रहते हैं।
    </string>
    <string name="settings_about_us_mission_title">हमारा मिशन</string>
    <string name="settings_about_us_mission_body">
        हम लोगों को रोज़मर्रा की आदतों को कुछ नया सीखने के मौके में बदलकर उनका समय और ध्यान वापस पाने में मदद करना चाहते हैं।
    </string>
    <string name="settings_about_us_who_title">हम कौन हैं</string>
    <string name="settings_about_us_who_body">
        ProcrastiLearn को एक इंडिपेंडेंट डेवलपर बनाता और मेंटेन करता है, जिसे प्रोडक्टिविटी और भाषा सीखने का शौक है।
    </string>
    <string name="settings_about_us_values_title">हमारी वैल्यूज़</string>
    <string name="settings_about_us_values_simplicity">सिंप्लिसिटी: डिस्ट्रैक्शन-फ्री, मिनिमल डिज़ाइन।</string>
    <string name="settings_about_us_values_growth">ग्रोथ: हर दिन के छोटे कदम मिलकर लंबी प्रोग्रेस बनाते हैं।</string>
    <string name="settings_about_us_contact_title">संपर्क करें</string>
