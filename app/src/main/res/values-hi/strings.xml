    <!-- ─── Accessibility disclosure (A11y) ─────────────────────────────────── -->
    <string name="a11y_disclosure_title">हमें एक्सेसिबिलिटी की ज़रूरत क्यों है</string>
    <string name="a11y_disclosure_description">
        यह ऐप Android की एक्सेसिबिलिटी सर्विस परमिशन का इस्तेमाल यह पता लगाने के लिए करता है कि आप कब चुने हुए ऐप्स खोलते हैं
        (जैसे TikTok, Reddit या कोई भी ऐप जो आप चुनें), ताकि आगे बढ़ने से पहले आपको एक छोटा लर्निंग प्रॉम्प्ट दिखाया जा सके।
    </string>

    <string name="a11y_disclosure_section_access">हम क्या एक्सेस करते हैं</string>

    <string name="a11y_disclosure_access_details">
        • फिलहाल आपकी स्क्रीन पर कौन-सा ऐप खुला है।\n
        • हम आपके पासवर्ड, मैसेज या स्क्रीन पर मौजूद टेक्स्ट नहीं पढ़ते।\n
        • आपका डेटा कभी भी आपकी डिवाइस से बाहर नहीं जाता और न ही बेचा या शेयर किया जाता है।
    </string>

    <string name="a11y_disclosure_section_usage">इसका इस्तेमाल कैसे होता है</string>

    <!-- Original paragraph -->
    <string name="a11y_disclosure_usage_details">
        सिर्फ आपके चुने हुए ऐप्स के लिए लर्निंग ओवरले दिखाने के लिए।
        आप इसे सेटिंग्स में कभी भी बंद कर सकते हैं। हम यह डेटा न बेचते हैं, न शेयर करते हैं,
        यह कभी भी आपकी डिवाइस से बाहर नहीं जाता।
    </string>

    <string name="a11y_disclosure_checkbox">
        मैं समझता/समझती हूं और इस मकसद के लिए इस ऐप को एक्सेसिबिलिटी सर्विस परमिशन इस्तेमाल करने की अनुमति देता/देती हूं।
    </string>
